{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@workspace/dealnest",
    "build": "npm run build --workspace=@workspace/dealnest",
    "start": "tsx artifacts/dealnest/server.ts",
    "typecheck": "tsc --build",
    "lint": "tsc --build"
  },
  "dependencies": {
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
